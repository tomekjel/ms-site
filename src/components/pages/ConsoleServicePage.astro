      </div>

      <div class="faq-list-wrap" style="display: flex; flex-flow: column; gap: 1.25rem; width: 100%; max-width: 860px; margin: 0 auto;">
        {c.faqs.map((faq) => (
          <div class="subpage-card faq-card-item" style="padding: 1.5rem 1.75rem; width: 100%; box-sizing: border-box;">
            <h3 class="display-h5" style="margin-bottom: 0.5rem; color: #d32f2f;">{faq.q}</h3>
            <p class="paragraph t---neutral-10" style="margin: 0; line-height: 1.6;">{faq.a}</p>
