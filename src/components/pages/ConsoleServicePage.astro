      "@id": `https://multi-servis.pl${prefix}/serwis-konsol#faq`,
      "mainEntity": c.faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": lang === "pl" ? "Strona główna" : (lang === "en" ? "Home" : "Головна"), "item": `https://multi-servis.pl${prefix || "/"}` },
        { "@type": "ListItem", "position": 2, "name": lang === "pl" ? "Serwis Konsol" : (lang === "en" ? "Console Repair" : "Сервіс Консолей"), "item": `https://multi-servis.pl${prefix}/serwis-konsol` }
      ]
    }
  ]
});
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  wfPage="serwis-konsol"
  ogImage="/images/social-20preview.avif"
  lang={lang}
  keywords={lang === "pl" ? "serwis konsol Bydgoszcz, naprawa PS5, naprawa Xbox, wymiana HDMI konsola, Multi-Servis" : (lang === "en" ? "console repair Bydgoszcz, PS5 repair, Xbox repair, HDMI replacement, Multi-Servis" : "ремонт консолей Бидгощ, ремонт PS5, ремонт Xbox, заміна HDMI, Multi-Servis")}
>
  <script slot="head" type="application/ld+json" is:inline set:html={serviceSchema} />

  <!-- Unified Navbar -->
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Hero Section -->
