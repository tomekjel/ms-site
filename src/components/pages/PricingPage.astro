    hubLaptop: "Laptops",
    hubLaptopDesc: "Liquid damage repairs, BGA micro-soldering, screens, keyboards, charging ports, and thermal maintenance.",
    hubPc: "Desktop PCs",
    hubPcDesc: "Motherboard and graphics card short-circuit repair, gaming computers, thermal repasting, and power supplies.",
    hubConsole: "Game Consoles",
    hubConsoleDesc: "HDMI port replacement in PS5 and Xbox Series, liquid metal repasting, cooling, and power supply repairs.",
    detailsLink: "Details →"
  },
  uk: {
    seoTitle: "Прайс на ремонт електроніки Бидгощ | Діагностика 50 zł | Multi-Servis",
    seoDesc: "Прозорі правила сервісу електроніки в Бидгощі (Ku Wiatrakom 18). Фіксована плата за діагностику 50 zł, індивідуальна оцінка до початку ремонту. Оплата тільки готівкою, 3 міс. гарантії.",
    heroBadge: "Прозорі правила • Чесна оцінка",
    heroTitle: "Прайс та правила ремонту в Multi-Servis",
    heroSubtitle: "У нашому сервісі немає прихованих комісій чи штучних розцінок. Єдиною фіксованою платою є діагностика несправності за 50 zł. Вартість кожного ремонту розраховується індивідуально — роботу починаємо лише після вашого узгодження телефоном.",
    pills: ["💵 Оплата тільки готівкою", "🔍 Діагностика несправності 50 zł", "🤝 Чесна оцінка до ремонту", "🛡️ Гарантія 3 місяці", "⚡ Швидке виконання", "😊 Привітне та професійне обслуговування"],
    pricingBadge: "Модель розрахунків",
    pricingTitle: "Як розраховується вартість ремонту в майстерні?",
    pricingSubtitle: "Ви самі приймаєте рішення щодо ремонту після оцінки. Якщо вартість вас не влаштує, ви сплачуєте лише 50 zł за діагностику і забираєте пристрій.",
    card1Badge: "Фіксована діагностична плата",
    card1Title: "Діагностика пристрою",
    card1Price: "50 zł",
    card1Period: "/ одноразово",
    card1Desc: "Детальна перевірка несправності в майстерні та оцінка по телефону.",
    card1Btn: "Привезти техніку до сервісу →",
    card1Features: [
      "Точна локалізація пошкодженого компонента",
      "Дзвінок з вартістю запчастин та роботи",
