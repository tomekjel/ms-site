    step2Title: "Kontakt i Wycena",
    step2Desc: "Dzwonimy do Ciebie z informacją: co uległo usterce, jak należy to naprawić, jaki będzie całkowity koszt i czas oczekiwania.",
    step3Title: "Decyzja i Odbiór",
    step3Desc: "Jeśli się zgadzasz – naprawiamy i otrzymujesz 3 m-ce gwarancji. Jeśli nie – płacisz tylko 50 zł za diagnozę. Płatność wyłącznie gotówką.",
    hubsBadge: "Zakres usług",
    hubsTitle: "Co naprawiamy w warsztacie Multi-Servis?",
    hubsSubtitle: "Dowiedz się więcej o procesie diagnozy, metodach naprawy i typowych usterkach.",
    hubTv: "Telewizory",
    hubTvDesc: "Wymiana podświetlenia LED, naprawa zasilaczy, płyt głównych i modułów T-CON (LED, OLED, QLED).",
    hubLaptop: "Laptopy",
