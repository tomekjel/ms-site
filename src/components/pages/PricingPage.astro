    card2Title: "Ремонт TV / PC / Ноутбука",
    card2Price: "Оцінка",
    card2Period: "/ після огляду",
    card2Desc: "Ремонт виконується виключно після вашої згоди телефоном.",
    card2Btn: "Зателефонувати: 505 012 914 →",
    card2Features: [
      "Оригінальні або надійні OEM-деталі",
