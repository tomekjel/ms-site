};

const c = content[lang] || content.pl;

// Service Offer + BreadcrumbList JSON-LD
const pricingSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `https://multi-servis.pl${prefix}/cennik#diagnosis`,
      "name": lang === "pl" ? "Diagnoza sprzętu elektronicznego Bydgoszcz" : "Hardware Diagnostics Bydgoszcz",
      "provider": { "@id": "https://multi-servis.pl/#organization" },
      "areaServed": [
        { "@type": "City", "name": "Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Wyżyny, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Województwo kujawsko-pomorskie" }
      ],
      "offers": {
        "@type": "Offer",
        "price": "50",
        "priceCurrency": "PLN",
        "name": lang === "pl" ? "Diagnoza sprzętu" : "Hardware Diagnostics",
        "description": lang === "pl" ? "Precyzyjna diagnoza usterki telewizora, laptopa, PC lub konsoli w warsztacie, telefon z wyceną. Płatność wyłącznie gotówką." : "Hardware fault diagnostics at workshop with phone quote. Cash only.",
        "priceValidUntil": "2027-12-31"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": lang === "pl" ? "Strona główna" : (lang === "en" ? "Home" : "Головна"), "item": `https://multi-servis.pl${prefix || "/"}` },
        { "@type": "ListItem", "position": 2, "name": lang === "pl" ? "Cennik" : (lang === "en" ? "Pricing" : "Ціни"), "item": `https://multi-servis.pl${prefix}/cennik` }
      ]
    }
  ]
});
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  wfPage="cennik"
  ogImage="/images/social-20preview.avif"
  lang={lang}
  keywords={lang === "pl" ? "cennik serwis elektroniki Bydgoszcz, diagnoza 50 zł, cena naprawa telewizora, Multi-Servis cennik" : (lang === "en" ? "pricing electronics repair Bydgoszcz, diagnosis 50 PLN, TV repair cost, Multi-Servis pricing" : "ціни ремонт електроніки Бидгощ, діагностика 50 зл, Multi-Servis ціни")}
>
  <script slot="head" type="application/ld+json" is:inline set:html={pricingSchema} />

  <!-- Unified Navbar -->
  <Navbar lang={lang} currentPath={currentPath} />

  <!-- Hero Section -->
  <section class="section" style="padding-top: 2rem; padding-bottom: 3.5rem;">
    <div class="container centered" style="max-width: 860px; margin: 0 auto; text-align: center;">
      <nav aria-label="Breadcrumb" style="margin-bottom: 1rem; font-size: 0.875rem;">
          <ol style="list-style: none; padding: 0; margin: 0; display: inline-flex; align-items: center; gap: 0.5rem;">
            <li><a href={prefix || "/"} style="color: inherit; opacity: 0.75; text-decoration: none;">{lang === "pl" ? "Główna" : (lang === "en" ? "Home" : "Головна")}</a></li>
            <li aria-hidden="true" style="opacity: 0.4; font-size: 0.75rem;">/</li>
            <li aria-current="page" style="color: #d32f2f; font-weight: 600;">{lang === "pl" ? "Cennik" : (lang === "en" ? "Pricing" : "Ціни")}</li>
          </ol>
        </nav>
        <div class="section-badge">{c.heroBadge}</div>
      <h1 class="display-h1" style="margin-top: 0.75rem; margin-bottom: 1.25rem;">
        {c.heroTitle}
      </h1>
      <p class="large-paragraph t---neutral-10" style="max-width: 740px; margin: 0 auto 2rem auto;">
        {c.heroSubtitle}
      </p>

      <!-- Trust Mini-Okienka Pills -->
      <div class="hero-quick-stats" style="justify-content: center; margin: 0 auto;">
        {c.pills.map((pill, i) => (
          <div class={`hero-stat-pill ${i === 0 ? 'pill-cash-red' : ''}`}>
            {pill}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Cards Section -->
  <section class="section inverse" style="padding: 5rem 0;">
    <div class="container centered">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3.5rem auto;">
        <div class="section-badge" style="background: rgba(255,255,255,0.1); color: #ffffff;">{c.pricingBadge}</div>
        <h2 class="display-h2" style="margin-top: 0.75rem; color: #ffffff;">{c.pricingTitle}</h2>
        <p class="large-paragraph" style="color: rgba(255, 255, 255, 0.85);">
          {c.pricingSubtitle}
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 2.5rem; max-width: 980px; margin: 0 auto 3rem auto;">
        
        <!-- Card 1: Diagnoza sprzętu -->
        <div class="pricing-card" style="text-align: left; margin: 0 auto; width: 100%;">
          <div class="pricing-main">
            <div class="pricing-heading">
              <div class="section-badge" style="margin-bottom: 0.75rem; background: rgba(211, 47, 47, 0.25); color: #ff6b6b; border: 1px solid rgba(211, 47, 47, 0.4);">{c.card1Badge}</div>
              <h3 class="display-h4" style="color: #ffffff;">{c.card1Title}</h3>
            </div>
            <div class="pricing-description">
              <div class="price">
                <h4 class="display-h2" style="color: #d32f2f;">{c.card1Price}</h4>
                <div class="large-paragraph t---neutral-10" style="color: rgba(255,255,255,0.7);">{c.card1Period}</div>
              </div>
              <p class="paragraph t---neutral-10" style="color: rgba(255,255,255,0.85);">{c.card1Desc}</p>
            </div>
            <a href={`${prefix}/kontakt`} class="primary-button w-inline-block" style="text-align: center; justify-content: center; color: #ffffff !important;">
              <div class="button-content">
                <p class="button-text" style="color: #ffffff !important; margin: 0;">{c.card1Btn}</p>
              </div>
            </a>
          </div>
          <div class="check-list-wrap">
            {c.card1Features.map((feat, idx) => (
              <div class="icon-text">
                <div class="icon m w-embed">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#d32f2f" viewBox="0 0 256 256">
                    <path d="M232.49,80.49l-128,128a12,12,0,0,1-17,0l-56-56a12,12,0,1,1,17-17L96,183,215.51,63.51a12,12,0,0,1,17,17Z"></path>
                  </svg>
                </div>
                <p class="paragraph" style="color: #ffffff;">
                  {idx === c.card1Features.length - 1 ? <strong style="color: #ffffff;">{feat}</strong> : feat}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Card 2: Naprawa elektroniki -->
        <div class="pricing-card" style="text-align: left; margin: 0 auto; width: 100%;">
          <div class="pricing-main">
            <div class="pricing-heading">
              <div class="section-badge" style="margin-bottom: 0.75rem; background: rgba(211, 47, 47, 0.25); color: #ff6b6b; border: 1px solid rgba(211, 47, 47, 0.4);">{c.card2Badge}</div>
              <h3 class="display-h4" style="color: #ffffff;">{c.card2Title}</h3>
            </div>
            <div class="pricing-description">
              <div class="price">
                <h4 class="display-h2" style="color: #ffffff;">{c.card2Price}</h4>
                <div class="large-paragraph t---neutral-10" style="color: rgba(255,255,255,0.7);">{c.card2Period}</div>
              </div>
              <p class="paragraph t---neutral-10" style="color: rgba(255,255,255,0.85);">{c.card2Desc}</p>
            </div>
            <a href="tel:+48505012914" class="primary-button w-inline-block" style="text-align: center; justify-content: center; color: #ffffff !important;">
              <div class="button-content">
                <p class="button-text" style="color: #ffffff !important; margin: 0;">{c.card2Btn}</p>
              </div>
            </a>
          </div>
          <div class="check-list-wrap">
            {c.card2Features.map((feat, idx) => (
              <div class="icon-text">
                <div class="icon m w-embed">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#d32f2f" viewBox="0 0 256 256">
