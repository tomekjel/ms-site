    ],
    cashTitle: "Cash only payment",
    cashDesc: "In our workshop at Ku Wiatrakom 18 in Bydgoszcz, we accept cash only (both for the 50 PLN diagnosis and repair pickup). Several ATMs (Euronet, PKO BP, Santander) are available within a 2-minute walk.",
    procBadge: "Service Process",
    procTitle: "How repairs work step by step",
    procSubtitle: "Zero hidden costs and full control over every decision at every phase.",
    step1Title: "Diagnosis (50 PLN)",
