    detailsLink: "Szczegóły →"
  },
  en: {
    seoTitle: "Electronics Repair Pricing Bydgoszcz | 50 PLN Diagnosis | Multi-Servis",
    seoDesc: "Transparent pricing at Multi-Servis electronics workshop in Bydgoszcz (Ku Wiatrakom 18). Fixed 50 PLN fault diagnosis, individual repair quotes beforehand. Cash only payment, 3-month warranty.",
    heroBadge: "Transparent Rules • Fair Quotation",
    heroTitle: "Pricing & Repair Policies at Multi-Servis",
    heroSubtitle: "We have no hidden charges or misleading price tiers. The only fixed fee is a comprehensive 50 PLN fault diagnosis. The cost of every repair is determined individually based on the fault and component costs — work begins only after your phone confirmation.",
    pills: ["💵 Cash only payment", "🔍 Fault diagnosis 50 PLN", "🤝 Fair quote before repair", "🛡️ 3-month warranty", "⚡ Fast turnaround", "😊 Friendly & professional service"],
    pricingBadge: "Billing Model",
    pricingTitle: "How we charge for repairs in our workshop",
    pricingSubtitle: "You decide on costs after receiving our detailed quote. If you choose not to proceed, you only pay 50 PLN for the diagnosis.",
    card1Badge: "Fixed Diagnostic Fee",
    card1Title: "Hardware Diagnosis",
    card1Price: "50 PLN",
