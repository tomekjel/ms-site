---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Footer from "../components/Footer.astro";
import { translations, type Lang } from "../i18n/translations";
import "../styles/ix/index.css";

interface Props {
  lang?: Lang;
}

const { lang = "pl" } = Astro.props;
const t = translations[lang];

// Navigation paths
const homePath = lang === "pl" ? "/" : `/${lang}`;
const aboutPath = lang === "pl" ? "/about" : `/${lang}/about`;
const servicesAnchor = `${homePath}#uslugi`;
const processAnchor = `${homePath}#diagnoza`;
const pricingAnchor = `${homePath}#cennik`;
const caseStudiesPath = lang === "pl" ? "/case-studies" : `/${lang}/case-studies`;
const faqAnchor = `${homePath}#faq`;
const contactAnchor = `${homePath}#kontakt`;

// 2026 AI / Local SEO JSON-LD
const jsonLd = {
