        "addressCountry": "PL"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 53.108951,
        "longitude": 18.040959
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "10:00",
          "closes": "17:00"
        }
      ],
      "founder": {
        "@type": "Person",
        "name": "Tomasz Jeliński",
        "jobTitle": "Właściciel & Serwisant"
      },
      "legalName": "Multi-Servis Tomasz Jeliński",
      "sameAs": [
        "https://www.google.com/maps/search/?api=1&query=Multi-Servis+Tomasz+Jeli%C5%84ski+Ku+Wiatrakom+18+Bydgoszcz",
        "https://maps.google.com/?q=Multi-Servis+Tomasz+Jeli%C5%84ski+Ku+Wiatrakom+18+Bydgoszcz"
      ],
      "areaServed": [
        { "@type": "City", "name": "Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Wyżyny, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Fordon, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Bartodzieje, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Bielawy, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Szwederowo, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Wzgórze Wolności, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Błonie, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Kapuściska, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Śródmieście, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Osowa Góra, Bydgoszcz" },
        { "@type": "AdministrativeArea", "name": "Solec Kujawski" },
        { "@type": "AdministrativeArea", "name": "Białe Błota" },
        { "@type": "AdministrativeArea", "name": "Osielsko" },
        { "@type": "AdministrativeArea", "name": "Nowa Wieś Wielka" },
        { "@type": "AdministrativeArea", "name": "Województwo kujawsko-pomorskie" }
      ],
      "knowsAbout": [
        "Naprawa telewizorów LED OLED QLED",
        "Wymiana podświetlenia matrycy LED",
        "Serwis i naprawa laptopów Bydgoszcz",
        "Naprawa laptopa po zalaniu",
        "Czyszczenie układu chłodzenia laptopa i wymiana pasty",
        "Wymiana dysku HDD na SSD NVMe (przyspieszanie laptopa)",
        "Mikrolutowanie BGA SMD",
        "Serwis komputerów stacjonarnych i PC gaming",
        "Naprawa konsol PlayStation 5, PS4, Xbox, Nintendo Switch",
        "Wymiana portu HDMI w konsolach",
        "Wymiana ciekłego metalu w PS5",
        "Montaż monitoringu CCTV i kamer IP"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Usługi serwisowe Multi-Servis Bydgoszcz",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Serwis Telewizorów Bydgoszcz",
              "url": "https://multi-servis.pl/serwis-telewizorow"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Serwis Laptopów Bydgoszcz",
              "url": "https://multi-servis.pl/serwis-laptopow"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Serwis Komputerów PC Bydgoszcz",
              "url": "https://multi-servis.pl/serwis-komputerow"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Serwis Konsol do Gier Bydgoszcz",
              "url": "https://multi-servis.pl/serwis-konsol"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Cennik i Diagnoza Sprzętu",
              "url": "https://multi-servis.pl/cennik"
            }
          }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": `https://multi-servis.pl${lang === 'pl' ? '' : '/' + lang}#faqpage`,
      "mainEntity": t.faq.items.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
};

const jsonLdString = JSON.stringify(jsonLd);

const brands = [
  "Samsung", "LG OLED", "Sony", "Philips", "Asus ROG", 
  "Lenovo", "HP", "Dell", "TCL", "Panasonic", "Hikvision CCTV", "Dahua"
];
---

<Layout
  title={t.seo.title}
  description={t.seo.description}
  wfPage="68a413987ca3efce6f38eea6"
  ogImage="/images/social-20preview.avif"
  lang={lang}
>
  <script slot="head" type="application/ld+json" is:inline set:html={jsonLdString} />

  <!-- Navigation -->
  <Navbar lang={lang} currentPath={homePath} />

  <!-- Hero Section -->
  <section class="section hero">
    <div class="container">
      <div class="hero-wrap">
        <div class="hero">
          <div class="hero-text">
            <div class="hero-heading">
              <div class="section-badge">
                <span class="badge-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#d32f2f;"></span>
                <span>{t.hero.badge}</span>
              </div>
              <h1 data-w-id="fb183dfb-c60b-169b-83d2-10bc584a7ef6" class="display-h1">
                {t.hero.title}
              </h1>
              <div data-w-id="84760383-3241-c221-771a-33900488d0de" class="large-paragraph t---neutral-10">
                {t.hero.subtitle}
              </div>
            </div>

            <div data-w-id="42e4baa9-9891-fb60-296f-33f595a3edf6" class="hero-buttons">
              <a href="tel:+48505012914" data-figma-id="156:103" class="primary-button w-inline-block" style="color: #ffffff !important; text-decoration: none;">
                <div class="button-content">
                  <p data-figma-id="96:188" class="button-text" style="color: #ffffff !important; margin: 0;">{t.hero.ctaPhone}</p>
                </div>
              </a>
              <a href={contactAnchor} data-figma-id="156:103" class="outline-button w-inline-block" style="text-decoration: none;">
                <div class="button-content">
                  <p data-figma-id="96:188" class="button-text" style="color: #d32f2f !important; margin: 0;">{t.hero.ctaContact}</p>
                </div>
              </a>
            </div>
          </div>

          <div class="hero-ui">
            <div class="hero-ui-wrap">
              <img src="/images/multi-servis-logo.png" loading="lazy" data-w-id="1567ae63-759c-8e83-3eb8-a809b1c6d866" alt="Multi-Servis" class="hero-ui-card hero-ui-logo" />
              <div class="hero-ui-card-2 hero-info-card">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                  <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: #d32f2f;"></span>
                  <strong style="font-size: 0.9375rem; color: var(--neutral--neutral-12);">{lang === 'pl' ? 'Serwis czynny' : (lang === 'uk' ? 'Сервіс працює' : 'Workshop open')}</strong>
                </div>
                <p style="margin: 0 0 6px 0; font-size: 0.8125rem; color: var(--neutral--neutral-11);">{lang === 'pl' ? 'Pon. – Pt. 10:00 – 17:00' : (lang === 'uk' ? 'Пн. – Пт. 10:00 – 17:00' : 'Mon. – Fri. 10:00 – 17:00')}</p>
                <p style="margin: 0; font-size: 0.8125rem; font-weight: 700; color: #d32f2f;">Ku Wiatrakom 18, Bydgoszcz</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature Pills: wide horizontal layout from left to right with red borders and red text -->
        <div class="hero-quick-stats">
          <div class="hero-stat-pill pill-cash-red">
            {t.hero.pillCash}
          </div>
          <div class="hero-stat-pill">
            {t.hero.pillFast}
          </div>
          <div class="hero-stat-pill">
            {t.hero.pillService}
          </div>
          <div class="hero-stat-pill">
            {t.hero.pillDiagnosis}
          </div>
          <div class="hero-stat-pill">
            {t.hero.pillGuarantee}
          </div>
          <div class="hero-stat-pill">
            {t.hero.pillQuote}
          </div>
        </div>

        <!-- Serviced Brands Ticker -->
        <div data-w-id="71a70a0f-4395-10bb-a654-682d054f26a7" class="hero-ticker">
          <div class="ticker-h">
            <div class="ticker-gradient-h"></div>
            <div class="ticker-content-h">
              {brands.map((brand) => (
                <div class="customer-logo-badge">
                  <span class="badge-dot"></span>
                  <span>{brand}</span>
                </div>
              ))}
            </div>
            <div class="ticker-content-h">
              {brands.map((brand) => (
                <div class="customer-logo-badge">
                  <span class="badge-dot"></span>
                  <span>{brand}</span>
                </div>
              ))}
            </div>
            <div class="ticker-gradient-h _2"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="header-bg">
      <div class="stripe-left">
        <div class="stripe"></div>
        <div class="stripe"></div>
        <div class="stripe"></div>
        <div class="stripe-left-gradient"></div>
      </div>
      <div class="stripe-right">
        <div class="stripe"></div>
        <div class="stripe"></div>
        <div class="stripe"></div>
        <div class="stripe-right-gradient"></div>
      </div>
      <div class="stripe-gradient"></div>
    </div>
  </section>

  <!-- Process Section: 3 Expanding Cards Accordion -->
  <section id="diagnoza" data-w-id="bbe8cfa0-151a-5d87-90e8-3d9cc64006b4" class="section">
    <span id="process"></span>
    <div class="container centered">
      <div class="product-intro">
        <div style="margin-bottom: 2.5rem; text-align: center;">
          <div class="section-badge">{t.process.sectionBadge}</div>
          <h2 class="display-h2" style="margin-bottom: 0.5rem;">{t.process.sectionTitle}</h2>
          <p class="large-paragraph t---neutral-10" style="max-width: 620px; margin: 0 auto;">{t.process.sectionSubtitle}</p>
          <div class="cash-notice-box" style="margin: 1rem auto 0 auto;">
            💵 {t.pricing.cashNotice}
          </div>
        </div>

        <div data-w-id="52e17c10-f6e2-693e-51ca-ffc09f18755e" class="process">
          <!-- Step 1 -->
          <div id="w-node-ac84b08e-31a9-f841-3071-13f6eb1a9ce4-6f38eea6" data-w-id="ac84b08e-31a9-f841-3071-13f6eb1a9ce4" class="process-card _1 is-expanded">
            <div class="process-content-wrap _1">
              <div class="process-card-content _1">
                <div class="large-paragraph t---neutral-10" style="color: #d32f2f; font-weight: 800; font-size: 1.5rem;">01</div>
                <div class="process-card-text">
                  <h3 class="display-h5">{t.process.step1Title}</h3>
                  <div class="paragraph t---neutral-10">{t.process.step1Desc}</div>
                </div>
              </div>
              <div class="process-image-wrap _1">
                <div class="process-image _1"></div>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div data-w-id="ca53cf5d-ad22-f91e-28f1-062324241019" class="process-card _2">
            <div class="process-content-wrap _2">
              <div class="process-card-content _2">
                <div class="large-paragraph t---neutral-10" style="color: #d32f2f; font-weight: 800; font-size: 1.5rem;">02</div>
                <div class="process-card-text">
                  <h3 class="display-h5">{t.process.step2Title}</h3>
                  <div class="paragraph t---neutral-10">{t.process.step2Desc}</div>
                </div>
              </div>
              <div class="process-image-wrap _2">
                <div class="process-image _2"></div>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div id="w-node-acec6c3f-9070-2600-cf49-9f6b706cc9c0-6f38eea6" data-w-id="acec6c3f-9070-2600-cf49-9f6b706cc9c0" class="process-card _3">
            <div class="process-content-wrap _3">
              <div class="process-card-content _3">
                <div class="large-paragraph t---neutral-10" style="color: #d32f2f; font-weight: 800; font-size: 1.5rem;">03</div>
                <div class="process-card-text">
                  <h3 class="display-h5">{t.process.step3Title}</h3>
                  <div class="paragraph t---neutral-10">{t.process.step3Desc}</div>
                </div>
              </div>
              <div class="process-image-wrap _3">
                <div class="process-image _3"></div>
              </div>
            </div>
          </div>
        </div>

        <script is:inline>
          (function() {
            function setupProcessCards() {
              var cards = document.querySelectorAll('.process-card');
              if (!cards.length) return;
              cards.forEach(function(card) {
                card.addEventListener('mouseenter', function() {
                  cards.forEach(function(c) { c.classList.remove('is-expanded'); });
                  card.classList.add('is-expanded');
                });
                card.addEventListener('click', function() {
                  cards.forEach(function(c) { c.classList.remove('is-expanded'); });
                  card.classList.add('is-expanded');
                });
              });
            }
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', setupProcessCards);
            } else {
              setupProcessCards();
            }
            document.addEventListener('astro:page-load', setupProcessCards);
          })();
        </script>
      </div>
    </div>
  </section>

  <!-- Services Tabs Section -->
  <section id="uslugi" class="section">
    <span id="services"></span>
    <span id="feature"></span>
    <div class="container centered">
      <div data-wf--section-header--variant="center" class="section-header">
        <div class="section-badge">{t.services.sectionBadge}</div>
        <h2 data-w-id="43e163e0-a4bf-51fc-16fd-fc73e02b5638" class="display-h2">{t.services.sectionTitle}</h2>
        <div data-w-id="43e163e0-a4bf-51fc-16fd-fc73e02b563a" class="large-paragraph t---neutral-10">{t.services.sectionSubtitle}</div>
      </div>

      <div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="tab-wrap w-tabs">
        <div id="w-node-d1ab5cee-5f58-fa45-8302-636b2739224b-6f38eea6" class="tab-menu w-tab-menu">
          <!-- Tab 1: TV -->
          <a data-w-tab="Tab 1" class="tab-item w-inline-block w-tab-link w--current">
            <div class="tab-item-text">📺 {t.services.tvTitle}</div>
          </a>

          <!-- Tab 2: Laptop -->
          <a data-w-tab="Tab 2" class="tab-item w-inline-block w-tab-link">
            <div class="tab-item-text">💻 {t.services.laptopTitle}</div>
          </a>

          <!-- Tab 3: PC -->
          <a data-w-tab="Tab 3" class="tab-item w-inline-block w-tab-link">
            <div class="tab-item-text">🖥️ {t.services.pcTitle}</div>
          </a>

          <!-- Tab 4: Konsole -->
          <a data-w-tab="Tab 4" class="tab-item w-inline-block w-tab-link">
            <div class="tab-item-text">🎮 Serwis Konsol</div>
          </a>

          <!-- Tab 5: CCTV -->
          <a data-w-tab="Tab 5" class="tab-item w-inline-block w-tab-link">
            <div class="tab-item-text">📹 {t.services.cctvTitle}</div>
          </a>
        </div>

        <div id="w-node-d1ab5cee-5f58-fa45-8302-636b2739225c-6f38eea6" class="tab-content w-tab-content">
          <!-- Pane 1: TV -->
          <div data-w-tab="Tab 1" class="tab-option _1 w-tab-pane w--tab-active">
            <div class="feature-tab-content">
              <div class="feature-tab-ui">
                <img src="/images/service-tv-repair.jpg" loading="lazy" alt={t.services.tvTitle} class="feature-tab-photo" />
              </div>
              <div class="feature-content">
                <div class="feature-tag"><div class="tag">Serwis TV Bydgoszcz</div></div>
                <h3 class="display-h3">{t.services.tvTitle}</h3>
                <div class="paragraph t---neutral-10">{t.services.tvDesc}</div>
                <ul style="margin-top: 1rem; padding-left: 1.25rem; color: var(--neutral--neutral-11); line-height: 1.8;">
                  {t.services.tvPoints.map((pt) => <li>{pt}</li>)}
                </ul>
                <div style="margin-top: 1.25rem; width: 100%;">
                  <a href="/serwis-telewizorow" class="primary-button w-inline-block" style="text-decoration:none; color:#ffffff !important;">
                    <div class="button-content">
                      <p class="button-text" style="color:#ffffff !important; margin:0;">Cennik i szczegóły serwisu TV &rarr;</p>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pane 2: Laptop -->
          <div data-w-tab="Tab 2" class="tab-option _2 w-tab-pane">
            <div class="feature-tab-content">
              <div class="feature-tab-ui">
                <img src="/images/service-laptop-repair.jpg" loading="lazy" alt={t.services.laptopTitle} class="feature-tab-photo" />
              </div>
              <div class="feature-content">
                <div class="feature-tag"><div class="tag">Serwis Laptopów Bydgoszcz</div></div>
                <h3 class="display-h3">{t.services.laptopTitle}</h3>
                <div class="paragraph t---neutral-10">{t.services.laptopDesc}</div>
                <ul style="margin-top: 1rem; padding-left: 1.25rem; color: var(--neutral--neutral-11); line-height: 1.8;">
                  {t.services.laptopPoints.map((pt) => <li>{pt}</li>)}
                </ul>
                <div style="margin-top: 1.25rem; width: 100%;">
                  <a href="/serwis-laptopow" class="primary-button w-inline-block" style="text-decoration:none; color:#ffffff !important;">
                    <div class="button-content">
                      <p class="button-text" style="color:#ffffff !important; margin:0;">Cennik i szczegóły laptopów &rarr;</p>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pane 3: PC -->
          <div data-w-tab="Tab 3" class="tab-option w-tab-pane">
            <div class="feature-tab-content">
              <div class="feature-tab-ui">
                <img src="/images/service-pc-repair.jpg" loading="lazy" alt={t.services.pcTitle} class="feature-tab-photo" />
              </div>
              <div class="feature-content">
                <div class="feature-tag"><div class="tag">Komputery PC Bydgoszcz</div></div>
                <h3 class="display-h3">{t.services.pcTitle}</h3>
                <div class="paragraph t---neutral-10">{t.services.pcDesc}</div>
                <ul style="margin-top: 1rem; padding-left: 1.25rem; color: var(--neutral--neutral-11); line-height: 1.8;">
                  {t.services.pcPoints.map((pt) => <li>{pt}</li>)}
                </ul>
                <div style="margin-top: 1.25rem; width: 100%;">
                  <a href="/serwis-komputerow" class="primary-button w-inline-block" style="text-decoration:none; color:#ffffff !important;">
                    <div class="button-content">
                      <p class="button-text" style="color:#ffffff !important; margin:0;">Cennik i szczegóły komputerów PC &rarr;</p>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Pane 4: Konsole -->
          <div data-w-tab="Tab 4" class="tab-option w-tab-pane">
            <div class="feature-tab-content">
              <div class="feature-tab-ui">
                <img src="/images/service-console-repair.jpg" loading="lazy" alt="Serwis konsol PS5, Xbox, Nintendo Switch Bydgoszcz" class="feature-tab-photo" />
              </div>
              <div class="feature-content">
                <div class="feature-tag"><div class="tag">Serwis Konsol Bydgoszcz</div></div>
                <h3 class="display-h3">Serwis PlayStation 5, Xbox Series X/S, Nintendo Switch</h3>
                <div class="paragraph t---neutral-10">Specjalistyczna naprawa konsol do gier w Bydgoszczy. Wymiana wyrwanych portów HDMI, naprawa układów zasilania oraz serwis chłodzenia ciekłym metalem w PS5.</div>
                <ul style="margin-top: 1rem; padding-left: 1.25rem; color: var(--neutral--neutral-11); line-height: 1.8;">
                  <li>Precyzyjna wymiana portów HDMI (lutowanie mikroskopowe SMD)</li>
                  <li>Czyszczenie układu chłodzenia i odświeżenie ciekłego metalu w PS5</li>
                  <li>Usuwanie zwarć sekcji zasilania i wymiana portów USB-C w Nintendo Switch</li>
                  <li>Rzetelna diagnoza 50 zł i 3 miesiące gwarancji</li>
                </ul>
                <div style="margin-top: 1.25rem; width: 100%;">
